<Window x:Class="CasualtiesModManager.NexusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Mods — Casualties: Unknown" Width="820" Height="680" MinWidth="640" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Заголовок ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="NX" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NEXUS MODS" FontFamily="Bahnschrift" FontSize="13"
                               FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Casualties: Unknown" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="10,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== Аккаунт и nxm ===== -->
            <Border Grid.Row="1" Margin="20,4,20,0" Padding="16,12"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource ChipButton}" Click="Account_Click" Margin="0,0,8,0"
                                ToolTip="Указать или сменить личный API-ключ Nexus Mods">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AccountDot" Width="8" Height="8" Margin="0,0,8,0"
                                         Fill="{StaticResource DangerBrush}"/>
                                <TextBlock x:Name="AccountText" Text="Нужен API-ключ"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Click="Nxm_Click"
                                ToolTip="Менеджер ловит ссылки nxm:// с кнопки скачивания на сайте Nexus. Это заменит Vortex / Mod Organizer в роли обработчика ссылок, пока приём включён.">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NxmDot" Width="8" Height="8" Margin="0,0,8,0"
                                         Fill="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="NxmText" Text="Приём nxm-ссылок: выкл"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="FreeNote" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"
                               Text="Бесплатный аккаунт: после «Установить» откроется страница мода на Nexus. Нажми там «Slow download» (или «Mod manager download»), и менеджер сам скачает и поставит мод. Для этого должен быть включён приём nxm-ссылок. У Premium мод ставится сразу."/>
                </StackPanel>
            </Border>

            <!-- ===== Поиск и сортировка ===== -->
            <Grid Grid.Row="2" Margin="20,14,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="36"
                         TextChanged="SearchBox_TextChanged"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="SortPopular" Style="{StaticResource ChipButton}" Tag="Popular" Click="Sort_Click"
                            Content="Популярные" Margin="0,0,6,0"/>
                    <Button x:Name="SortNewest" Style="{StaticResource ChipButton}" Tag="Newest" Click="Sort_Click"
                            Content="Новые" Margin="0,0,6,0"/>
                    <Button x:Name="SortUpdated" Style="{StaticResource ChipButton}" Tag="Updated" Click="Sort_Click"
                            Content="Обновлённые" Margin="0,0,6,0"/>
                    <Button x:Name="SortEndorsed" Style="{StaticResource ChipButton}" Tag="Endorsed" Click="Sort_Click"
                            Content="По лайкам"/>
                </StackPanel>
            </Grid>

            <!-- ===== Каталог ===== -->
            <Grid Grid.Row="3" Margin="20,0,10,0">
                <ListBox x:Name="ModsList" SelectionMode="Single"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="64" Height="64" CornerRadius="10" ClipToBounds="True"
                                        Background="{StaticResource AccentDimBrush}" VerticalAlignment="Top">
                                    <Image Source="{Binding Picture, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary, Mode=OneWay}" Margin="0,3,0,0" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Meta, Mode=OneWay}" Margin="0,4,0,0" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="16,7" FontSize="12"
                                            MinWidth="104" Margin="0,0,6,0"
                                            Content="{Binding ButtonText, Mode=OneWay}"
                                            IsEnabled="{Binding CanInstall, Mode=OneWay}"
                                            Tag="{Binding}" Click="Install_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                            Tag="{Binding}" Click="OpenPage_Click"
                                            ToolTip="Открыть страницу мода на Nexus Mods"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"/>
            </Grid>

            <!-- ===== Подвал ===== -->
            <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="20,10" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,10,0"
                                 Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Показать ещё" Padding="16,6" Visibility="Collapsed" Click="More_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
