<Window x:Class="CasualtiesModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CasualtiesModManager"
        Title="Casualties Mod Manager" Width="900" Height="680" MinWidth="720" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop" StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Заголовок окна ===== -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="CU" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CASUALTIES MOD MANAGER" FontFamily="Bahnschrift" FontSize="13"
                               FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" Click="Settings_Click"
                            ToolTip="{loc:Tr Tip_Settings}"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== Игра и BepInEx ===== -->
            <Border Grid.Row="1" Margin="20,4,20,0" Padding="18,14"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Tr Game_Label}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="GamePathText" FontSize="14" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WarningText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChipButton}" Click="PickGame_Click" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Game_PickTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="GameDot" Width="8" Height="8" Margin="0,0,8,0"
                                         Fill="{StaticResource DangerBrush}"/>
                                <TextBlock x:Name="GameChipText" Text="{loc:Tr Game_NotFound}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Click="InstallBep_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BepDot" Width="8" Height="8" Margin="0,0,8,0"
                                         Fill="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="BepChipText" Text="BepInEx"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Панель действий ===== -->
            <Grid Grid.Row="2" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Вкладки: список модов / каталог Nexus -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <RadioButton x:Name="TabMods" GroupName="MainTabs" Style="{StaticResource TabButton}"
                                 Content="{loc:Tr Tab_Mods}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNexus" GroupName="MainTabs" Style="{StaticResource TabButton}"
                                 Content="{loc:Tr Tab_Nexus}" Checked="Tab_Checked"/>
                </StackPanel>

                <WrapPanel x:Name="ActionsPanel" Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Click="AddMod_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Btn_AddMod}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="AddByLink_Click" Margin="0,0,8,0"
                            ToolTip="{loc:Tr Tip_ByLink}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Btn_ByLink}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="Export_Click" Margin="0,0,8,0"
                            ToolTip="{loc:Tr Tip_Export}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Btn_Export}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="Import_Click" Margin="0,0,8,0"
                            ToolTip="{loc:Tr Tip_Import}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Btn_Import}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Rescan_Click"
                            ToolTip="{loc:Tr Tip_Rescan}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Click="OpenGameFolder_Click"
                            ToolTip="{loc:Tr Tip_OpenFolder}"/>
                </WrapPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Launch_Click" Padding="22,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Btn_Play}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== Список модов ===== -->
            <Grid x:Name="ModsPanel" Grid.Row="3" Margin="20,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="36"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button x:Name="UpdateAllButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Height="36" Padding="16,0" Margin="8,0,0,0" Visibility="Collapsed"
                            Content="{loc:Tr Btn_UpdateAll}" Click="UpdateAll_Click"
                            ToolTip="{loc:Tr Tip_UpdateAll}"/>
                    <Button x:Name="CheckButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="14,0" Margin="8,0,0,0" Click="CheckUpdates_Click"
                            ToolTip="{loc:Tr Tip_CheckUpdates}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Btn_Updates}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox x:Name="ModsList" Grid.Row="1" SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="ModsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="46" Height="46" CornerRadius="10"
                                        Background="{StaticResource AccentDimBrush}">
                                    <TextBlock Text="{Binding Kind, Mode=OneWay}" FontFamily="Bahnschrift"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SourceFile, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SourceText, Mode=OneWay}" Margin="0,3,0,0" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status, Mode=OneWay}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center"
                                        Padding="12,6" FontSize="12" Tag="{Binding}" Click="UpdateOne_Click"
                                        Content="{Binding UpdateButtonText, Mode=OneWay}"
                                        ToolTip="{loc:Tr Tip_UpdateOne}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" MinWidth="34"
                                               TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{loc:Tr Toggle_Off}"/>
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Text" Value="{loc:Tr Toggle_On}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Tag="{Binding}" Click="Toggle_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE71B;"
                                            Tag="{Binding}" Click="LinkSource_Click"
                                            ToolTip="{loc:Tr Tip_Source}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                            Tag="{Binding}" Click="RemoveOne_Click"
                                            ToolTip="{loc:Tr Tip_Remove}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние -->
                <Grid x:Name="EmptyState" Grid.Row="1" Margin="0,0,10,12">
                    <Rectangle Stroke="{StaticResource LineBrush}" StrokeThickness="2"
                               StrokeDashArray="4 4" RadiusX="16" RadiusY="16"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Empty_Title}" FontFamily="Bahnschrift" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Empty_Sub}" Margin="0,6,0,18"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Btn_PickFiles}"
                                Click="AddMod_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Каталог Nexus (вкладка) ===== -->
            <loc:NexusView x:Name="NexusPane" Grid.Row="3" Margin="20,0,0,0" Visibility="Collapsed"/>

            <!-- ===== Подвал ===== -->
            <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="20,11" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,10,0"
                                 Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                                   Text="{loc:Tr Status_Ready}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <!-- ===== Подсветка при перетаскивании файлов ===== -->
            <Border x:Name="DropOverlay" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="#E60E0F12">
                <Grid Margin="20">
                    <Rectangle Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                               StrokeDashArray="5 4" RadiusX="16" RadiusY="16"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Drop_Release}" FontFamily="Bahnschrift" FontSize="22"
                                   FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
